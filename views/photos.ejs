<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your Photos — <%= event.name %> — FaceGala</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <style>
    body { background:#0f0f1a; color:#e0e0e0; }
    .photo-card { border-radius:10px; overflow:hidden; background:#1a1a2e; border:1px solid #2a2a4e; transition:transform .2s; cursor:pointer; }
    .photo-card:hover { transform:scale(1.02); }
    .photo-card img { width:100%; height:220px; object-fit:cover; display:block; }
    .face-thumb { width:72px; height:72px; object-fit:cover; border-radius:50%; border:3px solid #e94560; }
    .badge-back { background:#e94560; }
    .text-muted { color:#888 !important; }
    /* Lightbox overlay */
    #lightbox { display:none; position:fixed; inset:0; background:rgba(0,0,0,.92); z-index:9999; align-items:center; justify-content:center; }
    #lightbox.open { display:flex; }
    #lightbox img { max-width:92vw; max-height:90vh; border-radius:8px; object-fit:contain; }
    #lightbox-close { position:absolute; top:1rem; right:1.5rem; font-size:2rem; color:#fff; cursor:pointer; line-height:1; }
  </style>
</head>
<body>
  <%- include('partials/_header') %>

  <div class="container py-4">

    <!-- Breadcrumb -->
    <div class="d-flex align-items-center gap-2 mb-4 flex-wrap">
      <a href="/" class="text-white-50 text-decoration-none">All Events</a>
      <span class="text-white-50">/</span>
      <a href="/events/<%= event.id %>" class="text-white-50 text-decoration-none"><%= event.name %></a>
      <span class="text-white-50">/</span>
      <span>My Photos</span>
    </div>

    <!-- Person header -->
    <div class="d-flex align-items-center gap-3 mb-4">
      <img src="/public/faces/<%= event.id %>/<%= cluster.cover_thumb %>" class="face-thumb" alt="Face">
      <div>
        <h3 class="mb-0">Your Photos</h3>
        <p class="text-muted mb-0 small">
          <strong class="text-white"><%= photos.length %></strong>
          <%= photos.length === 1 ? 'photo' : 'photos' %> found in <em><%= event.name %></em>
        </p>
      </div>
      <a href="/events/<%= event.id %>" class="btn btn-sm ms-auto" style="background:#1a1a2e;border:1px solid #2a2a4e;color:#aaa;">
        &#8592; Back to faces
      </a>
    </div>

    <!-- Photo grid -->
    <% if (photos.length === 0) { %>
      <div class="text-center text-muted py-5">No photos found for this face.</div>
    <% } else { %>
      <div class="row g-3">
        <% for (const photo of photos) { %>
          <div class="col-6 col-md-4 col-lg-3">
            <div class="photo-card" onclick="openLightbox('/uploads/<%= event.id %>/<%= photo.filename %>')">
              <img src="/uploads/<%= event.id %>/<%= photo.filename %>" alt="Event photo" loading="lazy">
            </div>
          </div>
        <% } %>
      </div>
    <% } %>

  </div>

  <!-- Lightbox -->
  <div id="lightbox">
    <span id="lightbox-close" onclick="closeLightbox()">&times;</span>
    <img id="lightbox-img" src="" alt="Full size photo">
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function openLightbox(src) {
      document.getElementById('lightbox-img').src = src;
      document.getElementById('lightbox').classList.add('open');
    }
    function closeLightbox() {
      document.getElementById('lightbox').classList.remove('open');
    }
    document.getElementById('lightbox').addEventListener('click', function(e) {
      if (e.target === this) closeLightbox();
    });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLightbox(); });
  </script>
</body>
</html>
