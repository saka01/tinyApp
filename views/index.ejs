<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FaceGala</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <style>
    body { background:#0f0f1a; color:#e0e0e0; }
    .hero { background:linear-gradient(135deg,#1a1a2e,#16213e); padding:4rem 0 3rem; text-align:center; }
    .hero h1 { font-size:3rem; font-weight:800; }
    .hero h1 span { color:#e94560; }
    .card-event { background:#1a1a2e; border:1px solid #2a2a4e; border-radius:12px; transition:transform .2s,box-shadow .2s; }
    .card-event:hover { transform:translateY(-4px); box-shadow:0 8px 24px rgba(233,69,96,.25); }
    .badge-count { background:#e94560; font-size:.75rem; }
    .create-box { background:#16213e; border:1px solid #2a2a4e; border-radius:12px; }
    .btn-primary { background:#e94560; border-color:#e94560; }
    .btn-primary:hover { background:#c73652; border-color:#c73652; }
    .text-muted { color:#888 !important; }
  </style>
</head>
<body>
  <%- include('partials/_header') %>

  <div class="hero">
    <div class="container">
      <h1>Welcome to <span>FaceGala</span></h1>
      <p class="lead text-white-50 mt-2">Photographers upload event photos. Guests find every shot they're in — instantly.</p>
    </div>
  </div>

  <div class="container py-5">
    <div class="row g-4">

      <!-- Create event -->
      <div class="col-12">
        <div class="create-box p-4">
          <h5 class="mb-3">&#43; Create New Event</h5>
          <form action="/events" method="POST" class="d-flex gap-2 flex-wrap">
            <input type="text" name="name" class="form-control" style="max-width:360px;background:#0f0f1a;border-color:#2a2a4e;color:#e0e0e0;"
                   placeholder="e.g. Spring Gala 2026" required>
            <button type="submit" class="btn btn-primary px-4">Create</button>
          </form>
        </div>
      </div>

      <!-- Event list -->
      <% if (events.length === 0) { %>
        <div class="col-12 text-center text-muted py-4">
          <p>No events yet — create one above and start uploading photos.</p>
        </div>
      <% } else { %>
        <div class="col-12">
          <h5 class="mb-3">Events</h5>
        </div>
        <% for (const ev of events) { %>
          <div class="col-sm-6 col-lg-4">
            <a href="/events/<%= ev.id %>" class="text-decoration-none">
              <div class="card-event p-4">
                <div class="d-flex justify-content-between align-items-start">
                  <h6 class="mb-1 text-white"><%= ev.name %></h6>
                  <span class="badge badge-count"><%= ev.photo_count %> photos</span>
                </div>
                <small class="text-muted"><%= new Date(ev.created_at).toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'}) %></small>
              </div>
            </a>
          </div>
        <% } %>
      <% } %>

    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
