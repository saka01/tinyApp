<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= event.name %> — FaceGala</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <style>
    body { background:#0f0f1a; color:#e0e0e0; }
    .section-box { background:#1a1a2e; border:1px solid #2a2a4e; border-radius:12px; }
    .face-card { cursor:pointer; border-radius:10px; overflow:hidden; border:2px solid transparent; transition:border-color .2s,transform .2s; }
    .face-card:hover { border-color:#e94560; transform:scale(1.05); }
    .face-card img { width:100%; height:130px; object-fit:cover; display:block; }
    .btn-primary { background:#e94560; border-color:#e94560; }
    .btn-primary:hover { background:#c73652; border-color:#c73652; }
    .btn-outline-secondary { border-color:#2a2a4e; color:#aaa; }
    .btn-outline-secondary:hover { background:#2a2a4e; color:#fff; }
    .progress { background:#2a2a4e; }
    .progress-bar { background:#e94560; }
    .alert-custom { background:#1e1e3a; border:1px solid #e94560; color:#f8a5b3; border-radius:8px; padding:.75rem 1rem; }
    label.form-label { color:#aaa; }
    .text-muted { color:#888 !important; }
    .badge-pill { background:#e94560; }
    h4 { color:#e94560; }
  </style>
</head>
<body>
  <%- include('partials/_header') %>

  <div class="container py-4">

    <!-- Header -->
    <div class="d-flex align-items-center gap-3 mb-4">
      <a href="/" class="text-white-50 text-decoration-none">&#8592; All Events</a>
      <span class="text-white-50">/</span>
      <h2 class="mb-0"><%= event.name %></h2>
    </div>

    <!-- Error banner -->
    <% if (error) { %>
      <div class="alert-custom mb-4">
        <% if (error === 'no_face') { %>
          No face detected in your selfie. Try a clearer, well-lit photo.
        <% } else if (error === 'no_match') { %>
          No matching face found in this event. Make sure you're in one of the photos!
        <% } else if (error === 'no_selfie') { %>
          Please choose a selfie file before submitting.
        <% } else { %>
          Something went wrong processing your selfie. Please try again.
        <% } %>
      </div>
    <% } %>

    <!-- Processing banner -->
    <div id="processingBanner" class="<%= processing ? '' : 'd-none' %> section-box p-3 mb-4">
      <div class="d-flex align-items-center gap-3">
        <div class="spinner-border spinner-border-sm text-danger" role="status"></div>
        <div class="flex-grow-1">
          <div class="small mb-1">Processing photos &amp; detecting faces…
            <span id="progressText" class="text-muted ms-2"></span>
          </div>
          <div class="progress" style="height:4px;">
            <div id="progressBar" class="progress-bar" role="progressbar" style="width:0%"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-4">

      <!-- LEFT: Face grid -->
      <div class="col-lg-8">
        <div class="section-box p-4">
          <h5 class="mb-1">Who&#39;s here?</h5>
          <p class="text-muted small mb-4">Click your face to see all photos you appear in.</p>

          <% if (clusters.length === 0) { %>
            <div class="text-center text-muted py-5">
              <% if (photoCount === 0) { %>
                No photos uploaded yet. Use the upload form to get started.
              <% } else { %>
                Processing photos… faces will appear here shortly.
              <% } %>
            </div>
          <% } else { %>
            <div class="row g-2" id="faceGrid">
              <% for (const cluster of clusters) { %>
                <div class="col-4 col-sm-3 col-md-2">
                  <a href="/events/<%= event.id %>/cluster/<%= cluster.id %>" class="text-decoration-none">
                    <div class="face-card">
                      <img src="/public/faces/<%= event.id %>/<%= cluster.cover_thumb %>"
                           alt="Person" loading="lazy">
                    </div>
                  </a>
                </div>
              <% } %>
            </div>
            <p class="text-muted small mt-3">
              <strong class="text-white"><%= clusters.length %></strong> unique
              <%= clusters.length === 1 ? 'person' : 'people' %> detected across
              <strong class="text-white"><%= photoCount %></strong> photos
            </p>
          <% } %>
        </div>
      </div>

      <!-- RIGHT: Upload + Selfie -->
      <div class="col-lg-4">

        <!-- Selfie match -->
        <div class="section-box p-4 mb-4">
          <h5 class="mb-1">&#128247; Find Me Automatically</h5>
          <p class="text-muted small mb-3">Upload a selfie and we'll find all your photos.</p>
          <form action="/events/<%= event.id %>/match" method="POST" enctype="multipart/form-data">
            <div class="mb-3">
              <label class="form-label small">Your selfie (JPG/PNG)</label>
              <input type="file" name="selfie" accept="image/*" class="form-control form-control-sm"
                     style="background:#0f0f1a;border-color:#2a2a4e;color:#e0e0e0;" required>
            </div>
            <button type="submit" class="btn btn-primary w-100 btn-sm">Match My Face</button>
          </form>
        </div>

        <!-- Photo upload -->
        <div class="section-box p-4">
          <h5 class="mb-1">&#128444; Upload Photos</h5>
          <p class="text-muted small mb-3">Photographers: add event photos here.</p>
          <form action="/events/<%= event.id %>/upload" method="POST" enctype="multipart/form-data">
            <div class="mb-3">
              <label class="form-label small">Select photos (JPG/PNG, up to 200)</label>
              <input type="file" name="photos" accept="image/*" multiple
                     class="form-control form-control-sm"
                     style="background:#0f0f1a;border-color:#2a2a4e;color:#e0e0e0;" required>
            </div>
            <button type="submit" class="btn btn-outline-secondary w-100 btn-sm">Upload &amp; Process</button>
          </form>
        </div>

      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Poll /events/:id/status while processing banner is visible
    const banner = document.getElementById('processingBanner');
    const bar    = document.getElementById('progressBar');
    const text   = document.getElementById('progressText');
    const grid   = document.getElementById('faceGrid');

    if (!banner.classList.contains('d-none')) {
      const eventId = '<%= event.id %>';
      const poll = setInterval(async () => {
        try {
          const res  = await fetch(`/events/${eventId}/status`);
          const data = await res.json();

          if (data.photoCount > 0) {
            const pct = Math.round((data.processedCount / data.photoCount) * 100);
            bar.style.width  = pct + '%';
            text.textContent = `${data.processedCount}/${data.photoCount} photos · ${data.clusterCount} faces found`;
          }

          if (data.done) {
            clearInterval(poll);
            banner.classList.add('d-none');
            location.reload(); // reload to show updated face grid
          }
        } catch (e) { /* network hiccup — keep polling */ }
      }, 2500);
    }
  </script>
</body>
</html>
